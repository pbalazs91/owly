{
  "manifest_version": 3,
  "name": "Owly – WhatsApp és helyi AI",
  "version": "0.3.0",
  "description": "WhatsApp Web összekapcsolása az Owlyval és a saját gépen futó Ollamával.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://web.whatsapp.com/*", "https://owlyapp.onrender.com/*", "http://127.0.0.1:11434/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Owly WhatsApp", "default_popup": "popup.html" },
  "content_scripts": [
    { "matches": ["https://web.whatsapp.com/*"], "js": ["content.js"], "run_at": "document_start" },
    { "matches": ["https://web.whatsapp.com/*"], "js": ["wpp-config.js", "vendor/wppconnect-wa.js", "page-bridge.js"], "world": "MAIN", "run_at": "document_idle" }
  ]
}
